# Sanity — optional. Without these, collections read the committed YAML.
# The Studio at /studio only mounts when PUBLIC_SANITY_PROJECT_ID is set.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Private datasets only.
SANITY_API_READ_TOKEN=
# `npm run sanity:migrate -- --write` only.
SANITY_API_WRITE_TOKEN=
