---
import { SITE_NAME, SITE_DESCRIPTION } from "@/consts.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const { title, description = SITE_DESCRIPTION, image } = Astro.props;

const isNoindex = isNoindexRoute(Astro.url.pathname);

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);

/* The old default pointed at `/main-assets/og-image.jpg`, which has never
   existed — every share rendered a blank card against a 404. Until there is a
   real asset, emit no image and let the platform fall back to a text card. */
const socialImage = image ? new URL(image, Astro.site) : null;
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
  @font-face {
    font-family: "Duforn Mono";
    src:
      url("/fonts/DufornMono-Regular.woff2") format("woff2"),
      url("/fonts/DufornMono-Regular.woff") format("woff");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Hitmarker Condensed";
    src: url("/fonts/HitmarkerCondensed-Black.woff2") format("woff2");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
</style>
<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover"
/>
{/* `viewport-fit=cover` lets the layout fill the Dynamic Island and home
    indicator. There is deliberately no `theme-color`: on iOS Safari a pinned
    theme-color paints those bands as opaque chrome, which overrides the
    bleed-through `viewport-fit=cover` exists for — the page then reads as a
    flat block above and below the content. With none set, the bands take the
    page's own ground. `black-translucent` is the standalone (Add to Home
    Screen) equivalent.

    ponytail: true edge-to-edge under the island is only guaranteed in
    standalone mode; in browsing mode Safari may still flatten the top band to
    the sampled page background. Upgrade path if that ever matters is a
    standalone-only layout, not a theme-color. */}
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{socialImage && <meta property="og:image" content={socialImage} />}

<meta
  name="twitter:card"
  content={socialImage ? "summary_large_image" : "summary"}
/>
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{socialImage && <meta name="twitter:image" content={socialImage} />}

<link rel="icon" type="image/svg+xml" href="/main-assets/favicon.svg" />
<link rel="icon" href="/main-assets/favicon.ico" />
<meta name="generator" content={Astro.generator} />
