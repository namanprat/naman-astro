---
/**
 * Work gallery on the Lumos grid. Markup is Astro; `WorkGallery.ts` owns the
 * slider/wheel engines and the Flip overlay. React is not involved.
 */
import type { WorkItem } from "@/content/work";
import type { ViewItem } from "@/lib/content/models";
import ViewSwitcher from "@/components/ViewSwitcher.astro";
import ProjectDetail from "./ProjectDetail.astro";
import "./Work.css";

interface Props {
  items: WorkItem[];
  views?: readonly ViewItem[];
}

const DEFAULT_VIEWS = [
  { id: "slider", label: "Slider" },
  { id: "grid", label: "Grid" },
] as const;

const { items, views } = Astro.props;
const workViews = (views ?? []).filter(
  (view) => view.id === "slider" || view.id === "grid",
);
const tabs = workViews.length ? workViews : DEFAULT_VIEWS;
---

<div class="work_wrap is-loading" data-work-view="slider">
  <p
    class="gallery_label gooey_reveal text-style-display"
    role="heading"
    aria-level={1}
    aria-live="polite"
  >
    <span class="gooey_reveal_inner">
      Works<span class="gallery_label_count">({items.length})</span>
    </span>
  </p>

  <div class="gallery container" aria-label="Selected work">
    {
      items.map((item, index) => (
        <figure
          class="gallery_slide"
          data-slug={item.slug}
          data-title={item.title}
          data-href={`/work/${item.slug}`}
          data-span={item.span}
          data-index={index}
          tabindex={0}
          role="link"
          aria-label={`View ${item.title}`}
          style={`--slide-span: ${item.span}; --slide-col: ${item.col};`}
        >
          <div class="gallery_img_wrap">
            <img
              class="gallery_img"
              src={item.image}
              alt={item.alt}
              loading="eager"
              draggable="false"
            />
          </div>
        </figure>
      ))
    }
  </div>

  <ViewSwitcher label="Work view" views={tabs} view="slider" busy />

  <div class="content" aria-hidden="true">
    <div class="content_wrap">
      <div class="content_group_list">
        {items.map((item, index) => (
          <ProjectDetail item={item} variant="overlay" index={index} />
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  import { bootWorkGallery } from "./WorkGallery";
  bootWorkGallery();
</script>
