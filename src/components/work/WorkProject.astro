---
import type { WorkItem } from "@/content/work";
import ProjectDetail from "./ProjectDetail.tsx";
import Footer from "../site/Footer.tsx";
import "./Work.css";

interface Props {
  item: WorkItem;
}

const { item } = Astro.props;
---

{/* No client directive: `ProjectDetail` is markup only, so the whole case
    study ships as HTML. It used to live inside a `client:only` scroll island,
    which meant `/work/[slug]` served no content at all until React had
    booted. */}
<article class="work_project">
  <ProjectDetail item={item} />
</article>
<Footer client:only="react" />
<script>
  import { bootLazyVideos } from "@/lib/site/lazyVideo";
  import { bootSiteScroll } from "@/lib/site/lenisScroll";
  bootSiteScroll();
  // The case study is server-rendered, so its video is in the document before
  // any island boots — no need to wait for one.
  bootLazyVideos();
</script>
