---
/**
 * Work page shell — infinite gallery + Flip project overlay.
 * No Lenis: the gallery owns wheel/touch via GSAP Observer.
 */
import { getWorkItems, toWorkItem } from "@/lib/content/work";
import WorkGallery from "./WorkGallery.astro";

const items = (await getWorkItems()).map(toWorkItem);
---

<WorkGallery items={items} />
