---
/**
 * Case-study body on the Lumos 12-col grid. Shared by the hard `/work/[slug]`
 * page and the Flip overlay on `/work`.
 */
import { groupWorkPanels, type WorkItem } from "@/content/work";
import Grid from "@/components/Wrapper/Grid.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";

interface Props {
  item: WorkItem;
}

const { item } = Astro.props;
const groups = groupWorkPanels(item.panels);
---

<div class="project_layout" data-project-track>
  <section class="project_hero">
    <Heading tag="h1" variant="display" class="project_title">{item.title}</Heading>
    <div class="container gap-0 project_hero_contain">
      <Grid class="is-12 project_hero_grid">
        <div class="project_services">
          <div class="project_services_list">
            {item.services.map((service) => (
              <Heading tag="h5" variant="main">{service}</Heading>
            ))}
          </div>
        </div>
        <div class="project_intro">
          <Paragraph variant="main" class="project_body">{item.description}</Paragraph>
          {
            item.website ? (
              <Button
                element="link"
                variant="link"
                href={item.website}
                target="_blank"
                rel="noreferrer noopener"
                class="project_website"
              >
                Open website
              </Button>
            ) : null
          }
        </div>
      </Grid>
    </div>
  </section>

  <section class="project_cover">
    <div class="container gap-0">
      <Grid class="is-12">
        <figure class="project_cover_media" data-project-preview>
          <img src={item.image} alt={item.alt} draggable="false" />
        </figure>
        {
          item.coverVideo ? (
            <figure class="project_cover_video">
              <video
                data-lazy-src={item.coverVideo}
                aria-label={`${item.title} reveal`}
                muted
                loop
                playsinline
                preload="none"
              />
            </figure>
          ) : null
        }
        {
          item.coverImage ? (
            <figure class="project_cover_below">
              <img src={item.coverImage} alt={item.alt} draggable="false" />
            </figure>
          ) : null
        }
      </Grid>
    </div>
  </section>

  {
    groups.map((group) =>
      group.kind === "pair" ? (
        <section class="project_block is-pair">
          <div class="container gap-0">
            <Grid class="is-12">
              <figure class="project_panel_media">
                <img
                  src={group.src}
                  alt={group.alt}
                  draggable="false"
                  loading="lazy"
                />
              </figure>
              <div class="project_copy">
                <Heading tag="h2" variant="h3" class="project_copy_title">
                  {group.title}
                </Heading>
                <Paragraph variant="main" class="project_copy_body">
                  {group.body}
                </Paragraph>
              </div>
            </Grid>
          </div>
        </section>
      ) : group.kind === "image" ? (
        <section class="project_block is-image">
          <div class="container gap-0">
            <Grid class="is-12">
              <figure class="project_panel_media">
                <img
                  src={group.src}
                  alt={group.alt}
                  draggable="false"
                  loading="lazy"
                />
              </figure>
            </Grid>
          </div>
        </section>
      ) : (
        <section class="project_block is-text">
          <div class="container gap-0">
            <Grid class="is-12">
              <div class="project_copy">
                <Heading tag="h2" variant="h3" class="project_copy_title">
                  {group.title}
                </Heading>
                <Paragraph variant="main" class="project_copy_body">
                  {group.body}
                </Paragraph>
              </div>
            </Grid>
          </div>
        </section>
      ),
    )
  }
</div>
