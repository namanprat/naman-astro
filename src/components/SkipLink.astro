---
interface Props {
  /** Id of the element it jumps to, written without the `#`. */
  target?: string;
  /** What it says once it is on screen. */
  label?: string;
}

const { target = "main", label = "Skip to main content" } = Astro.props;
---

<a class="skip_link" href={`#${target}`}>{label}</a>

<style is:global>
  @layer components {
    /* First thing in the tab order, parked above the viewport until it takes
       focus so it covers nothing for anyone who never tabs to it. */
    .skip_link {
      position: fixed;
      top: var(--space-2);
      inset-inline-start: var(--space-2);
      z-index: 100;
      translate: 0 calc(-100% - var(--space-2) * 2);
      padding: 0.75em 1.5em;
      background-color: var(--button-background);
      color: var(--button-text);
      border: var(--border-width) solid var(--button-border);
      border-radius: 0.5em;
      text-decoration: none;

      &:focus {
        translate: 0 0;
      }
    }
  }
</style>
