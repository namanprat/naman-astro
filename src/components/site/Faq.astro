---
import { getEntry } from "astro:content";
import Section from "@/components/Wrapper/Section.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Accordion from "@/components/Interactive/Accordion.astro";
import AccordionItem from "@/components/Interactive/AccordionItem.astro";

const site = await getEntry("site", "site");
if (!site) throw new Error("content: the `site` entry is missing");
const { statement, lead, items } = site.data.faq;
---

<Section
  class="faq_wrap"
  id="faq"
  aria-label="FAQ"
  paddingTop="large"
  paddingBottom="large"
  gap="0"
>
  <Grid class="is-12 studio_layout faq_layout">
    <div class="faq_statement studio_statement">
      <Heading tag="h2" variant="h2" class="faq_title studio_title">
        <span class="studio_title_indent" aria-hidden="true"></span>{statement}
      </Heading>
    </div>

    <Paragraph variant="h4" class="faq_lead">{lead}</Paragraph>

    <Accordion class="faq_items" single={false}>
      {
        items.map((item) => (
          <AccordionItem heading={item.question}>
            <Paragraph variant="main">{item.answer}</Paragraph>
          </AccordionItem>
        ))
      }
    </Accordion>
  </Grid>
</Section>

<style>
  @layer components.section {
    .faq_layout {
      grid-column: 1 / -1;
    }

    .faq_statement {
      grid-column: 1 / span calc(10 * var(--_responsive---large) + 12 * (1 - var(--_responsive---large)));
    }

    .faq_lead {
      grid-column: calc(7 * var(--_responsive---large) + 1) / span calc(5 * var(--_responsive---large) + 12 * (1 - var(--_responsive---large)));
      margin: 0;
      color: var(--text);
    }

    .faq_items {
      grid-column: calc(7 * var(--_responsive---large) + 1) / span calc(5 * var(--_responsive---large) + 12 * (1 - var(--_responsive---large)));
    }
  }
</style>
