---
/**
 * Featured-work carousel. 8-col Lumos stage; clip-path hop + gooey titles.
 * Overlay: title top-left, white-filled arrows bottom-right; chips sit
 * centered under the image on the landscape stage (hidden on mobile).
 */
import { getFeaturedWorkItems, workHref } from "@/lib/content/work";
import Section from "@/components/Wrapper/Section.astro";
import Grid from "@/components/Wrapper/Grid.astro";

const SLIDES = (await getFeaturedWorkItems()).map((entry) => ({
  title: entry.data.title,
  kicker: entry.data.services.join(", "),
  href: workHref(entry),
  src: entry.data.image,
  alt: entry.data.alt,
  film: entry.data.coverVideo,
  poster: entry.data.image,
}));

const first = SLIDES[0];
---

<Section
  class="hero_slider_wrap"
  id="series"
  aria-label="Featured work"
  paddingTop="large"
  paddingBottom="large"
  gap="0"
>
  <Grid class="is-12 studio_layout hero_slider_layout">
      <div class="hero_slider_stage gap-row-4">
        <div class="hero_slider_frame">
          <div class="hero_slider_images">
            {
              SLIDES.map((slide, i) => (
                <div
                  class:list={["hero_slider_img", { "is-active": i === 0 }]}
                  data-slide-index={i}
                  data-slide-title={slide.title}
                  data-slide-kicker={slide.kicker}
                  data-slide-href={slide.href}
                >
                  {
                    slide.film ? (
                      <video
                        class="hero_slider_photo"
                        src={slide.film}
                        poster={slide.poster}
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        aria-label={slide.alt}
                      />
                    ) : (
                      <img
                        class="hero_slider_photo"
                        src={slide.src}
                        alt={slide.alt}
                        draggable="false"
                        loading="eager"
                        decoding="async"
                      />
                    )
                  }
                </div>
              ))
            }
          </div>

          <div class="hero_slider_overlay padding-4">
            <div class="hero_slider_copy">
              {
                /* Host class is parked by initHeroSlider via revealClass(),
                  not hardcoded — same hand-built inner as Footer. */
              }
              <h2 class="hero_slider_title text-style-h1">
                <span class="hero_slider_title_inner gooey_reveal_inner"
                  >{first?.title ?? ""}</span
                >
              </h2>
              <p class="hero_slider_kicker text-style-small">
                <span class="hero_slider_kicker_inner gooey_reveal_inner"
                  >{first?.kicker ? `[ ${first.kicker} ]` : ""}</span
                >
              </p>
            </div>

            <div class="hero_slider_rail flex-horizontal-nowrap gap-2">
              <button
                type="button"
                class="hero_slider_prev padding-4"
                aria-label="Previous slide"
              >
                <svg
                  class="hero_slider_icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 -960 960 960"
                  aria-hidden="true"
                >
                  <path d="M640-200 200-480l440-280v560Z"></path>
                </svg>
              </button>
              <span class="hero_slider_index text-style-small">01</span>
              <button
                type="button"
                class="hero_slider_next padding-4"
                aria-label="Next slide"
              >
                <svg
                  class="hero_slider_icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 -960 960 960"
                  aria-hidden="true"
                >
                  <path d="M320-200v-560l440 280-440 280Z"></path>
                </svg>
              </button>
            </div>
          </div>
          <div class="hero_slider_cursor text-style-small" aria-hidden="true">view</div>
          <a
            class="hero_slider_hit sr-only"
            href={first?.href ?? "/work"}
            data-no-reveal
          >
            View project
          </a>
        </div>
        <div
          class="hero_slider_pills flex-horizontal-nowrap gap-2 alignment-center"
          role="tablist"
          aria-label="Featured projects"
        >
          {
            SLIDES.map((slide, i) => (
              <button
                type="button"
                class:list={[
                  "hero_slider_pill",
                  "text-style-small",
                  { "is-active": i === 0 },
                ]}
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                data-slide-index={i}
              >
                <span class="roll_text">{slide.title}</span>
              </button>
            ))
          }
        </div>
      </div>
    </Grid>
</Section>

<script>
  import { initHeroSlider } from "./HeroSlider";

  document.querySelectorAll(".hero_slider_wrap").forEach((node) => {
    if (!(node instanceof HTMLElement) || node.dataset.scriptInitialized)
      return;
    node.dataset.scriptInitialized = "true";
    initHeroSlider(node);
  });
</script>

<style>
  /* ponytail: scoped, and layered on purpose. Astro adds its cid to this
     component's own selectors and leaves `html.*` alone, so nothing here can
     reach another component. The `@layer` wrapper is what keeps that from
     changing the cascade: a scoped block is unlayered by default and unlayered
     beats every layer, so without it these rules would outrank the whole
     `components` layer they came from — `.hero_slider_pill` is on
     FluidCanvas's trail-blend list, which is exactly that kind of rule. */
@layer components.section {
  .hero_slider_layout {
    grid-column: 1 / -1;
  }

  /* Every breakpoint below keys off this one signal: how wide the stage itself
     ended up. Named, because the frame declares a container of its own and an
     unnamed query inside the overlay would resolve to that instead. */
  .hero_slider_stage {
    container: hero-slider / inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    grid-column: calc(2 * var(--_responsive---large) + 1) / span calc(8 * var(--_responsive---large) + 12 * (1 - var(--_responsive---large)));
    width: 100%;
    min-width: 0;
    user-select: none;
  }

  .hero_slider_frame {
    position: relative;
    width: 100%;
    aspect-ratio: 10 / 16;
    overflow: clip;
    background-color: var(--background-skeleton);
    color: var(--light-100);
    container-type: inline-size;
  }

  .hero_slider_images {
    position: absolute;
    inset: 0;
  }

  .hero_slider_img {
    position: absolute;
    inset: 0;
    visibility: hidden;
    z-index: 0;
  }

  .hero_slider_img.is-active,
  .hero_slider_img.is-hopping {
    visibility: visible;
    z-index: 1;
  }

  .hero_slider_img.is-hopping.is-incoming {
    z-index: 2;
  }

  .hero_slider_photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background-color: var(--background-skeleton);
  }

  /* Title top-left, white-filled arrows bottom-right. Chips live under
     the frame, not on the photo. Padding comes from Lumos utilities. */
  .hero_slider_overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
    color: var(--light-100);
  }

  .hero_slider_overlay > * {
    pointer-events: auto;
  }

  .hero_slider_rail {
    flex: 0 0 auto;
    align-self: end;
  }

  .hero_slider_index {
    flex: none;
    color: var(--light-100);
    white-space: nowrap;
  }

  .hero_slider_prev,
  .hero_slider_next {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    border: var(--border-width) solid var(--light-100);
    border-radius: 0;
    background-color: var(--light-100);
    color: var(--dark-900);
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
  }

  .hero_slider_prev:hover,
  .hero_slider_next:hover {
    background-color: var(--dark-900);
    border-color: var(--dark-900);
    color: var(--light-100);
  }

  .hero_slider_copy {
    min-width: 0;
    flex: 0 1 auto;
    color: var(--light-100);
  }

  .hero_slider_title {
    margin: 0;
    text-align: start;
    color: var(--light-100);
  }

  .hero_slider_kicker {
    margin: var(--space-2) 0 0;
    color: var(--light-100);
  }

  .hero_slider_icon {
    display: block;
    width: 1.5rem;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    fill: currentColor;
  }

  /* Trails the pointer over the photo. Same box as the chips under the
     image — square corners, space-1 / space-3 pad — so the label reads as
     one of those, not a different control. System cursor stays visible. */
  .hero_slider_cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: var(--z--overlay);
    display: none;
    align-items: center;
    pointer-events: none;
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--brand-500);
    border-radius: 0;
    background-color: var(--brand-500);
    color: var(--brand-text);
    line-height: 1;
    white-space: nowrap;
    will-change: transform;
  }

  .hero_slider_cursor::before,
  .hero_slider_cursor::after {
    content: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero_slider_frame.is-view-cursor .hero_slider_cursor {
      display: flex;
    }

    .hero_slider_frame,
    .hero_slider_images,
    .hero_slider_photo {
      cursor: pointer;
    }
  }

  /* Chips sit under the frame on the landscape stage. Portrait/mobile
     keeps only the overlay arrows — the pill row is too tight there. */
  .hero_slider_pills {
    display: none;
    flex: 0 0 auto;
    align-self: stretch;
    justify-content: center;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .hero_slider_pills::-webkit-scrollbar {
    display: none;
  }

  .hero_slider_pill {
    display: flex;
    align-items: center;
    flex: none;
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border: var(--border-width) solid var(--text);
    border-radius: 0;
    background-color: var(--text);
    color: var(--background);
    cursor: pointer;
    white-space: nowrap;
    line-height: 1;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      border-style 200ms ease;
  }

  /* text-style-small's leading-trim ::before/::after would inflate the
     chip past the view label's 1lh box. Kill the same pair as the cursor. */
  .hero_slider_pill::before,
  .hero_slider_pill::after {
    content: none;
  }

  .hero_slider_pill.is-active {
    background-color: transparent;
    border-color: var(--text);
    border-style: dashed;
    color: var(--text);
  }

  @container hero-slider (width >= 40rem) {
    .hero_slider_frame {
      aspect-ratio: 16 / 10;
    }

    .hero_slider_pills {
      display: flex;
    }
  }
}
</style>
