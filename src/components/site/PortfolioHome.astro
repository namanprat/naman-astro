---
/**
 * Portfolio home shell. Lenis boots in a root island; studio sections are
 * siblings so native Astro (CamilleSlider) can sit between React islands.
 * Footer/Menu read Lenis from `lenisBridge` when outside the ReactLenis tree.
 */
import HomeLenis from "./PortfolioHome.tsx";
import Manifesto from "./Manifesto.tsx";
import CamilleSlider from "./CamilleSlider.astro";
import Process from "./Process.tsx";
import Faq from "./Faq.tsx";
import Team from "./Team.tsx";
import Footer from "./Footer.tsx";
---

<HomeLenis client:only="react" />
<section class="hero" id="hero" aria-label="Home"></section>
<div class="studio">
  <Manifesto client:only="react" />
  <CamilleSlider />
  <Process client:only="react" />
  <Faq client:only="react" />
  <Team client:only="react" />
</div>
<Footer client:only="react" />
