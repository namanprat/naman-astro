---
/**
 * Portfolio home shell. Studio sections are siblings so native Astro
 * (CamilleSlider overlay chrome) can sit between React islands. Footer/Menu
 * read the document scroller from `lenisBridge`.
 */
import Manifesto from "./Manifesto.astro";
import CamilleSlider from "./CamilleSlider.astro";
import Process from "./Process.tsx";
import Faq from "./Faq.tsx";
import Team from "./Team.astro";
import Footer from "./Footer.tsx";
---

<section class="hero" id="hero" aria-label="Home">
  {/* Hero footnotes, phone only. The section is otherwise an empty spacer that
      reserves the first viewport, which makes it the one box already sized to
      the screen these two can hang off. */}
  <p class="hero_note text-style-main">
    Brand, web, and motion<br />for early-stage companies.
  </p>
  <a class="hero_scroll" href="#studio">
    <span class="sr-only">Skip to the studio</span>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M12 4v15m0 0 5.5-5.5M12 19l-5.5-5.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="square"></path>
    </svg>
  </a>
</section>
<div class="studio" id="studio">
  <Manifesto />
  <CamilleSlider />
  {/* Must stay `client:only`. `revealLines` and `bootGooeyHeadings` run from
      BaseLayout's boot script and rewrite headings and body copy with SplitText
      before React hydrates, so a server-rendered React subtree mismatches and
      React throws the whole thing away — which also loses the split. Astro
      markup (Team) and never-hydrated components (Manifesto, ProjectDetail) are
      free to server-render because nothing hydrates over them. The WebGL win
      here is independent: `ProcessCardCanvas` is lazy and mount-gated. */}
  <Process client:only="react" />
  {/* `client:only` for the same reason as `Process` above. */}
  <Faq client:only="react" />
  <Team />
</div>
<Footer client:only="react" />
<script>
  import { bootSiteScroll } from "@/lib/site/lenisScroll";
  bootSiteScroll();
</script>
