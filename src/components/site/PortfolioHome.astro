---
import { getEntry } from "astro:content";
import Manifesto from "./Manifesto.astro";
import HeroSlider from "./HeroSlider.astro";
import Process from "./Process.astro";
import Faq from "./Faq.astro";
import Team from "./Team.astro";
import Footer from "./Footer.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";

const site = await getEntry("site", "site");
if (!site) throw new Error("content: the `site` entry is missing");
const { eyebrow } = site.data;
---

<section class="hero" id="hero" aria-label="Home">
  <Paragraph variant="main" class="hero_note">
    {eyebrow.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
  </Paragraph>
  <a class="hero_scroll" href="#studio">
    <span class="sr-only">Skip to the studio</span>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M12 4v15m0 0 5.5-5.5M12 19l-5.5-5.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="square"></path>
    </svg>
  </a>
</section>
<div class="studio" id="studio">
  <Manifesto />
  <HeroSlider />
  <Process />
  <Faq />
  <Team />
</div>
<Footer />
<script>
  import { bootSiteScroll } from "@/lib/site/scroll/lenisScroll";
  bootSiteScroll();
</script>
