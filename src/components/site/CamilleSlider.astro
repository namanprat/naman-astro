---
/**
 * Featured-work carousel. 8-col Lumos stage; clip-path hop + gooey titles.
 * Overlay: title top-left, arrows in a row top-right, chips along the
 * image bottom. Slides stay `featuredWorkItems`.
 */
import { featuredWorkItems } from "@/content/work";
import "./CamilleSlider.css";

// ponytail: placeholder art from the cg-yzavoku slider stands in for the real
// covers. Swap `src`/`alt` back to `item.image`/`item.alt` to restore them.
const SLIDES = featuredWorkItems.map((item, i) => ({
  title: item.title,
  kicker: item.services[0] ?? "",
  href: `/work/${item.slug}`,
  src: `/slider/slide-${i + 1}.jpg`,
  alt: item.alt,
}));

const first = SLIDES[0];
---

<section
  class="camille_slider_wrap studio_section"
  id="series"
  aria-label="Featured work"
>
  <div class="camille_slider_contain container gap-0">
    <div class="camille_slider_layout studio_layout grid is-12">
      <div class="camille_slider_stage">
        <div class="camille_slider_frame">
          <div class="camille_slider_images">
            {
              SLIDES.map((slide, i) => (
                <div
                  class:list={["camille_slider_img", { "is-active": i === 0 }]}
                  data-slide-index={i}
                  data-slide-title={slide.title}
                  data-slide-kicker={slide.kicker}
                  data-slide-href={slide.href}
                >
                  <img
                    class="camille_slider_photo"
                    src={slide.src}
                    alt={slide.alt}
                    draggable="false"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              ))
            }
          </div>

          <div class="camille_slider_overlay padding-4 gap-2">
            <div
              class="camille_slider_top flex-horizontal-nowrap justify-content-between gap-2"
            >
              <div class="camille_slider_copy">
                {
                  /* Host class is parked by initCamilleSlider via revealClass(),
                    not hardcoded — same hand-built inner as Footer. */
                }
                <h2 class="camille_slider_title text-style-h2">
                  <span class="camille_slider_title_inner gooey_reveal_inner"
                    >{first?.title ?? ""}</span
                  >
                </h2>
                <p class="camille_slider_kicker text-style-small">
                  <span class="camille_slider_kicker_inner gooey_reveal_inner"
                    >{first?.kicker ? `[ ${first.kicker} ]` : ""}</span
                  >
                </p>
              </div>

              <div class="camille_slider_rail flex-horizontal-nowrap gap-2">
                <button
                  type="button"
                  class="camille_slider_prev padding-4"
                  aria-label="Previous slide"
                >
                  <svg
                    class="camille_slider_icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 -960 960 960"
                    aria-hidden="true"
                  >
                    <path d="M640-200 200-480l440-280v560Z"></path>
                  </svg>
                </button>
                <span class="camille_slider_index text-style-small">01</span>
                <button
                  type="button"
                  class="camille_slider_next padding-4"
                  aria-label="Next slide"
                >
                  <svg
                    class="camille_slider_icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 -960 960 960"
                    aria-hidden="true"
                  >
                    <path d="M320-200v-560l440 280-440 280Z"></path>
                  </svg>
                </button>
              </div>
            </div>

            <div
              class="camille_slider_pills flex-horizontal-nowrap gap-2"
              role="tablist"
              aria-label="Featured projects"
            >
              {
                SLIDES.map((slide, i) => (
                  <button
                    type="button"
                    class:list={[
                      "camille_slider_pill",
                      "text-style-small",
                      { "is-active": i === 0 },
                    ]}
                    role="tab"
                    aria-selected={i === 0 ? "true" : "false"}
                    data-slide-index={i}
                  >
                    {slide.title}
                  </button>
                ))
              }
            </div>
          </div>
          <div class="camille_slider_cursor" aria-hidden="true">view</div>
          <a
            class="camille_slider_hit sr-only"
            href={first?.href ?? "/work"}
            data-no-reveal
          >
            View project
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initCamilleSlider } from "@/lib/site/camilleSlider";

  document.querySelectorAll(".camille_slider_wrap").forEach((node) => {
    if (!(node instanceof HTMLElement) || node.dataset.scriptInitialized)
      return;
    node.dataset.scriptInitialized = "true";
    initCamilleSlider(node);
  });
</script>
