---
/**
 * Markup only. The lead used to run its own scrubbed word-by-word rise; it is
 * now an ordinary `h1`, picked up by the site-wide gooey entrance in
 * `lib/site/gooeyReveal.ts`. `.manifesto_wrap` is absent from that module's SKIP
 * list for exactly this reason.
 */
import "./Manifesto.css";
---

<section class="manifesto_wrap" aria-label="Manifesto">
  <div class="manifesto_contain container gap-0">
    <div class="manifesto_layout grid is-12">
      <h1 class="manifesto_lead text-style-h2">
        <span class="studio_title_indent" aria-hidden="true"></span>
        We're a design practice for early-stage brands, closing the gap between
        who you already are and how the world sees you. Good design isn't about
        adding more. It's about knowing what to leave out.
      </h1>
    </div>
  </div>
</section>
