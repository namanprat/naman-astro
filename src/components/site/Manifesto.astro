---
import { getEntry } from "astro:content";
import Section from "@/components/Wrapper/Section.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Heading from "@/components/Typography/Heading.astro";

const site = await getEntry("site", "site");
if (!site) throw new Error("content: the `site` entry is missing");
const { manifesto } = site.data;
---

<Section class="manifesto_wrap" aria-label="Manifesto" paddingTop="none" paddingBottom="none" gap="0">
  <Grid class="is-12 manifesto_layout">
    <Heading tag="h1" variant="h2" class="manifesto_lead">
      <span class="studio_title_indent" aria-hidden="true"></span>{manifesto}
    </Heading>
  </Grid>
</Section>

<style>
  @layer components.section {
    .manifesto_wrap {
      padding-top: 10vh;
      padding-bottom: 40vh;
    }

    .manifesto_layout {
      width: 100%;
    }

    .manifesto_lead {
      grid-column: 1 / span calc(10 * var(--_responsive---large) + 12 * (1 - var(--_responsive---large)));
      margin: 0;
      max-width: none;
      color: var(--text);
      text-wrap: wrap;
    }
  }
</style>
