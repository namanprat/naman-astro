---
/**
 * Home boot overlay. Static markup so it paints on first paint — no island, no
 * hydration gap. Driven by `@/lib/site/preloader`.
 *
 * Sits in the backdrop slot so the hero FluidCanvas shows through it; the
 * rest of the page is hidden by `html.is-preloading` (see site.css).
 *
 * Layout is Lumos: `.grid.is-12` for the card, utilities for padding, gap, flex
 * and type. Every grid child spans the full row and splits internally with
 * flex, so the left/right pairing survives all four column counts.
 */
---

<div class="preloader_wrap" role="dialog" aria-modal="true" aria-label="Loading" tabindex="-1">
  <div class="preloader_clip">
    <div class="preloader_card padding-4">
      <div class="preloader_grid grid is-12 gap-2 gap-row-4">
        <div class="preloader_mark" role="img" aria-label="Naman Pratulya">
        </div>

        <div
          class="preloader_row flex-horizontal-nowrap justify-content-between gap-2"
        >
          <p class="text-style-mono">
            Loaded <span data-preload-percent aria-live="polite">0%</span>
          </p>
          <p class="text-style-mono">
            Assets <span data-preload-assets>0/0</span>
          </p>
        </div>

        <div class="preloader_bar" aria-hidden="true">
          <div class="preloader_fill" data-preload-fill></div>
        </div>

        <div
          class="preloader_row preloader_foot justify-content-between align-items-end gap-2"
        >
          <p class="text-style-mono">
            Based in Mumbai and Bangalore, working worldwide<br />
            Brand, web, and motion for early-stage companies
          </p>
          <button
            type="button"
            class="preloader_cta text-style-mono radius-round"
            data-preload-cta
            disabled
          >
            <span class="roll_text" data-preload-cta-label>Enter</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .preloader_wrap {
    position: fixed;
    inset: 0;
    /* Just under .site-grain (1000000) so the grain overlays the card like it
       does every other surface. Transparent so the hero canvas behind it is
       the backdrop. Let the fluid keep receiving pointermove through the
       empty frame; only the card captures hits. */
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--site-margin);
    pointer-events: none;
    background: none;
    will-change: transform;
  }

  .preloader_clip,
  .preloader_card,
  .preloader_cta {
    pointer-events: auto;
  }

  /* Dark mode: black on accent. Light mode: white on frost — the same
     --surface-accent / --panel-ink pairing the About panel uses. */
  /* Exit mask — the card animates to yPercent -100 inside this, so it slides
     up behind the clip edge instead of drifting off over the page. */
  .preloader_clip {
    width: 100%;
    max-width: 38rem;
    overflow: clip;
  }

  .preloader_card {
    --card-ink: var(--dark-900);
    width: 100%;
    background-color: var(--surface-accent);
    color: var(--card-ink);
  }

  /* Blur only — the fill stays --surface-accent in both themes, matching
     .about_panel_surface and .footer_child exactly. */
  :global(html.theme-light) .preloader_card {
    --card-ink: var(--light-100);
    backdrop-filter: blur(var(--surface-frost-blur));
  }

  /* Every row spans the full grid, so the 4/6/8/12 column counts never
     reposition anything — the splits are flex, not grid placement. */
  .preloader_mark,
  .preloader_row,
  .preloader_bar {
    grid-column: 1 / -1;
  }

  /* Masked rather than <img> so the wordmark takes the card's ink colour, the
     same trick .name_hero_lockup uses in Menu.css. */
  .preloader_mark {
    width: min(16rem, 55%);
    aspect-ratio: 446 / 70;
    background-color: var(--card-ink);
    -webkit-mask: url(/main-assets/name-hero.svg) left center / contain no-repeat;
    mask: url(/main-assets/name-hero.svg) left center / contain no-repeat;
  }

  .preloader_foot {
    display: flex;
    flex-flow: row wrap;
  }

  .preloader_cta {
    flex: none;
    padding: 0.75em 2em;
    border: 0;
    background-color: var(--light-100);
    color: var(--dark-900);
    cursor: pointer;
    /* Opacity only, never `visibility: hidden` — a hidden element can't take
       focus, so the keyboard path would break the moment it unlocked. */
    opacity: 0;
  }

  .preloader_cta:disabled {
    cursor: default;
  }

  /* Two rows of dots. background-size tiles on both axes, so the row count is
     just the height divided by the pitch — no extra elements.
     Pitch matches the reference's cell rhythm (~60 columns across the card);
     the dot fills 80% of its cell so it reads as chunky as the ref's squares
     rather than a thin polka run. */
  .preloader_bar {
    --pitch: 0.5625rem;
    --dot: 40%;
    --rows: 3;
    position: relative;
    height: calc(var(--pitch) * var(--rows));
    background-image: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--card-ink) 30%, transparent) var(--dot),
      transparent calc(var(--dot) + 1%)
    );
    background-size: var(--pitch) var(--pitch);
  }

  /* Same dots at full strength, clipped by width. JS snaps that width to whole
     --pitch steps so a dot is never cut in half mid-column. */
  .preloader_fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background-image: radial-gradient(
      circle at center,
      var(--card-ink) var(--dot),
      transparent calc(var(--dot) + 1%)
    );
    background-size: var(--pitch) var(--pitch);
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader_wrap {
      will-change: auto;
    }
  }
</style>
