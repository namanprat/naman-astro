---
/**
 * Fluid backdrop. The wrap is static HTML so it is a real child of `main` —
 * `html.is-preloading main > *:not(.fluid-wrap)` can keep it visible. The
 * React island only mounts the canvas (`client:only` has no SSR output).
 *
 * In-flow on home (pulls under the hero chrome); fixed and blurred while
 * `html.is-preloading` so it fills the viewport behind the transparent
 * preloader.
 */
import FluidCanvas from "./FluidCanvas.tsx";
import "./FluidCanvas.css";
---

<div class="fluid-wrap" data-fluid aria-hidden="true">
  <FluidCanvas client:only="react" />
</div>
