---
import Analytics from "@vercel/analytics/astro";
import "@/styles/global.css";
import "@/styles/site.css";
import BaseHead from "@/components/BaseHead.astro";
import Menu from "@/components/site/Menu";
import GooeyFilter from "@/components/site/GooeyFilter.astro";
import FluidCanvas from "@/components/site/FluidCanvas.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark";
  /**
   * Route class on `<html>`, server-rendered so the layout rules keyed off it
   * (`Work.css`, `FluidCanvas.css`) apply pre-paint. Setting it from an island
   * effect instead lands it after hydration, which is a visible reflow on any
   * page whose content is server-rendered.
   */
  rootClass?: string;
};

const { theme = "inherit", rootClass, ...seo } = Astro.props;

const isArchive = Astro.url.pathname === "/archive";
---

<!doctype html>
<html
  lang="en"
  class:list={[theme !== "inherit" && `theme-${theme}`, rootClass]}
>
  <head>
    <BaseHead {...seo} />
    <script is:inline>
      document.documentElement.classList.add("is-line-revealing");
      document.documentElement.classList.add("is-gooey-arming");
      (function () {
        try {
          if (sessionStorage.getItem("pt:cover") === "1") {
            document.documentElement.classList.add("is-page-transitioning");
            document.documentElement.classList.add("is-page-covered");
          }
        } catch (e) {}
      })();
      /* Soft gooey: blur-only entrance, no alpha threshold. Opt-in rather than
         UA-detected — this used to force itself on for every WebKit build, back
         when the threshold was assumed impossible there. It has to run pre-paint
         because it decides the filter chain before any island paints a url().

         `?gooey=soft` flips one page load and sticks, `?gooey=melt` clears it. */
      (function () {
        try {
          var q = new URLSearchParams(location.search).get("gooey");
          if (q === "soft") localStorage.setItem("gooey", "soft");
          else if (q) localStorage.removeItem("gooey");
          if (localStorage.getItem("gooey") === "soft") {
            document.documentElement.classList.add("is-gooey-soft");
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("site-theme");
          if (t !== "light" && t !== "dark") return;
          var root = document.documentElement;
          root.classList.remove("theme-light", "theme-dark");
          root.classList.add("theme-" + t);
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
    <script is:inline>
      /* Hexes match THEME_COLOR_* in lib/site/themeColor.ts. Inline so the
         bar is right before React hydrates. Archive is always dark. */
      (function () {
        var root = document.documentElement;
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        if (!metas.length) {
          var created = document.createElement("meta");
          created.setAttribute("name", "theme-color");
          document.head.appendChild(created);
          metas = document.querySelectorAll('meta[name="theme-color"]');
        }
        var color = root.classList.contains("page-archive")
          ? "#101010"
          : root.classList.contains("theme-light")
            ? "#e2e2dd"
            : "#101010";
        for (var i = 0; i < metas.length; i++) metas[i].setAttribute("content", color);
      })();
    </script>
  </head>
  <body>
    {
      /* Every route: headings and the work label both filter through it, and a
        `url()` pointing at a missing node blanks the element on WebKit. */
    }
    <GooeyFilter />
    <div class="site-grain" aria-hidden="true"></div>
    <div class="transition_panel" aria-hidden="true"></div>
    <Menu client:load initialPathname={Astro.url.pathname} />
    <div class="site-backdrop">
      <slot name="backdrop" />
    </div>
    <main id="main">
      {!isArchive && <FluidCanvas />}
      <slot />
    </main>
    <script>
      import { bootIfCovered } from "@/lib/site/pageTransition";
      import { revealLines } from "@/lib/site/lineReveal";
      import { bootGooeyHeadings } from "@/lib/site/gooeyReveal";
      import { bootOverlayScrollbar } from "@/lib/site/overlayScrollbar";
      bootOverlayScrollbar();
      // Parallel, not chained: each owns its own hold class and its own 2s
      // failsafe, so chaining would stack the two budgets into a 4s worst case.
      void bootIfCovered().then(() => {
        void bootGooeyHeadings();
        void revealLines();
      });
    </script>
    <Analytics />
  </body>
</html>
