---
import Analytics from "@vercel/analytics/astro";
import "@/styles/global.css";
import "@/styles/site.css";
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import Menu from "@/components/site/Menu";
import GooeyFilter from "@/components/site/GooeyFilter.astro";
import FluidCanvas from "@/components/site/FluidCanvas.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark";
};

const { theme = "inherit", ...seo } = Astro.props;

const isArchive = Astro.url.pathname === "/archive";
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <script is:inline>
      document.documentElement.classList.add("is-line-revealing");
      document.documentElement.classList.add("is-gooey-arming");
      (function () {
        try {
          if (sessionStorage.getItem("pt:cover") === "1") {
            document.documentElement.classList.add("is-page-transitioning");
          }
        } catch (e) {}
      })();
      /* Soft gooey: blur-only entrance, no alpha threshold. Never UA-detected —
         this used to force itself on for every WebKit build, back when the
         threshold was assumed impossible there. It has to run pre-paint because
         it decides the filter chain before any island paints a url().

         Below the desktop breakpoint soft is the default, which extends the
         reasoning heroIntro.ts already applies to the wordmark: a 0.35em blur on
         phone-sized type is a large fraction of stroke width, so the threshold
         eats the strokes and the melt lands as mush rather than as a fuse. It is
         also the expensive half — WebKit rasterises a `url()` filter on the CPU,
         per line, per frame — so dropping it is what makes the entrance cheap
         enough for a phone.

         Not re-evaluated on resize: the gooey arms once per load and the site
         uses hard navigation, so there is no route change to re-arm on.

         `?gooey=soft` and `?gooey=melt` both stick, and an explicit choice wins
         over the breakpoint either way. */
      (function () {
        try {
          var q = new URLSearchParams(location.search).get("gooey");
          if (q === "soft" || q === "melt") localStorage.setItem("gooey", q);
          else if (q) localStorage.removeItem("gooey");
          var pref = localStorage.getItem("gooey");
          var soft =
            pref === "soft" ||
            (pref !== "melt" && !window.matchMedia("(width >= 64rem)").matches);
          if (soft) document.documentElement.classList.add("is-gooey-soft");
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("site-theme");
          if (t !== "light" && t !== "dark") return;
          var root = document.documentElement;
          root.classList.remove("theme-light", "theme-dark");
          root.classList.add("theme-" + t);
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    {
      /* Every route: headings and the work label both filter through it, and a
        `url()` pointing at a missing node blanks the element on WebKit. */
    }
    <GooeyFilter />
    <div class="site-grain" aria-hidden="true"></div>
    <div class="transition-panel" aria-hidden="true"></div>
    <Menu client:load initialPathname={Astro.url.pathname} />
    <div class="site-backdrop">
      <slot name="backdrop" />
    </div>
    {
      /* `tabindex` so the jump moves focus here, not just the scroll position */
    }
    <main id="main" tabindex="-1">
      {!isArchive && <FluidCanvas />}
      <slot />
    </main>
    <script>
      import { bootIfCovered } from "@/lib/site/pageTransition";
      import { revealLines } from "@/lib/site/lineReveal";
      import { bootGooeyHeadings } from "@/lib/site/gooeyReveal";
      import { bootOverlayScrollbar } from "@/lib/site/overlayScrollbar";
      bootOverlayScrollbar();
      // Parallel, not chained: each owns its own hold class and its own 2s
      // failsafe, so chaining would stack the two budgets into a 4s worst case.
      void bootIfCovered().then(() => {
        void bootGooeyHeadings();
        void revealLines();
      });
    </script>
    <Analytics />
  </body>
</html>
