---
import Layout from "@/layouts/BaseLayout.astro";
---

<Layout
  title="Page not found"
  description="The page you're looking for doesn't exist."
  theme="dark"
>
  <section class="not_found">
    <h1 class="text-style-h3">This page doesn't exist</h1>
    <p class="text-style-large">
      The page you're looking for may have moved, or the link that brought you
      here might be out of date.
    </p>
    <a class="not_found_link text-style-main" href="/">Back to home</a>
  </section>
</Layout>

<style>
  .not_found {
    box-sizing: border-box;
    /* `vh` is the large viewport, so on mobile Safari it centred this block
       against a screen taller than the one showing and pushed the link under the
       toolbar. */
    min-height: 100svh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: var(--section-space-nav-overlap) var(--site-margin);
    padding-bottom: calc(
      var(--section-space-nav-overlap) + var(--site--safe-area-bottom)
    );
    gap: var(--space-4);
    max-width: 36rem;
  }

  .not_found_link {
    color: var(--link-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
