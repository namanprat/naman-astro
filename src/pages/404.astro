---
import Layout from "@/layouts/BaseLayout.astro";
import ContentNotFound from "@/components/site/ContentNotFound.astro";
import { getEntry } from "astro:content";

const site = await getEntry("site", "site");
if (!site) throw new Error("content: the `site` entry is missing");
const { title, body, linkLabel } = site.data.notFound;
---

<Layout
  title="Page not found"
  description={body}
  theme="dark"
>
  <ContentNotFound title={title} body={body} linkLabel={linkLabel} />
</Layout>
