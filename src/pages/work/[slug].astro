---
import Layout from "@/layouts/BaseLayout.astro";
import { getWorkItems, toWorkItem } from "@/lib/content/work";
import WorkProject from "@/components/work/WorkProject.astro";

export async function getStaticPaths() {
  return (await getWorkItems()).map((entry) => ({
    params: { slug: entry.id },
    props: { item: toWorkItem(entry) },
  }));
}

const { item } = Astro.props;
---

<Layout
  title={item.title}
  description={item.description}
  theme="dark"
  rootClass="page-work-project"
>
  <WorkProject item={item} />
</Layout>
